{
  "name": "codebridge",
  "version": "0.1.0",
  "private": true,
  "description": "Secure local repository audit bridge over MCP",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "codebridge": "./dist/src/cli.js"
  },
  "files": [
    "dist/",
    "sandbox/",
    "plugin.json",
    "mcp.json",
    "scripts/codebridge-mcp",
    ".codex-plugin/",
    ".codex/",
    ".mcp.json",
    ".agents/",
    ".claude-plugin/",
    "skills/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "node dist/src/cli.js doctor",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/tests/*.test.js dist/tests/*/*.test.js",
    "test:coverage": "c8 --all --include=dist/src/**/*.js --check-coverage --lines 85 --branches 80 --reporter=text --reporter=lcov node --test dist/tests/*.test.js dist/tests/*/*.test.js",
    "test:sandbox-docker": "node scripts/docker-adversarial-smoke.mjs",
    "test:repository-dry-run": "node scripts/repository-dry-run.mjs",
    "check:security-coverage": "node scripts/check-security-coverage.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "ignore": "5.3.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "c8": "12.0.0",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
