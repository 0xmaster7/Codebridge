#!/usr/bin/env python3
"""Trusted clean-environment launcher installed in approved CodeBridge images."""

from __future__ import annotations

import argparse
import os
import shutil
import stat
import subprocess
import sys
from pathlib import Path

ADAPTERS = {
    "pytest",
    "ruff",
    "mypy",
    "pyright",
    "node-test",
    "node-lint",
    "node-typecheck",
    "project-script-sandboxed",
}
MAX_DEPTH = 128


def fail(message: str, status: int = 126) -> "None":
    print(f"codebridge-launch: {message}", file=sys.stderr)
    raise SystemExit(status)


def parse_invocation(argv: list[str]) -> tuple[argparse.Namespace, list[str]]:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--source", required=True)
    parser.add_argument("--workspace", required=True)
    parser.add_argument("--home", required=True)
    parser.add_argument("--tmp", required=True)
    parser.add_argument("--clean-env", action="store_true")
    try:
        separator = argv.index("--")
    except ValueError:
        fail("approved executable is missing")
    options, extra = parser.parse_known_args(argv[:separator])
    if extra or not options.clean_env or not argv[separator + 1 :]:
        fail("launcher arguments do not match the clean execution contract")
    return options, argv[separator + 1 :]


def clean_environment(home: str, temporary: str) -> dict[str, str]:
    return {
        "HOME": home,
        "TMPDIR": temporary,
        "CI": "true",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "NO_COLOR": "1",
        "PATH": "/usr/local/bin:/usr/bin:/bin",
    }


def copy_snapshot(source: Path, workspace: Path) -> None:
    try:
        root_info = source.lstat()
    except OSError as error:
        fail(f"snapshot source is unavailable: {error.strerror}")
    if not stat.S_ISDIR(root_info.st_mode):
        fail("snapshot source is not a real directory")
    if workspace.exists():
        workspace_info = workspace.lstat()
        if not stat.S_ISDIR(workspace_info.st_mode) or any(workspace.iterdir()):
            fail("bounded workspace is not an empty directory")
    else:
        workspace.mkdir(mode=0o700, parents=True)
    stack: list[tuple[Path, Path, int]] = [(source, workspace, 0)]
    while stack:
        source_dir, destination_dir, depth = stack.pop()
        if depth > MAX_DEPTH:
            fail("snapshot directory depth exceeds the launcher limit")
        try:
            directory_before = source_dir.lstat()
        except OSError as error:
            fail(f"snapshot directory changed during copy: {error.strerror}")
        if not stat.S_ISDIR(directory_before.st_mode):
            fail("snapshot directory is not a real directory")
        try:
            children = sorted(os.scandir(source_dir), key=lambda entry: entry.name)
        except OSError as error:
            fail(f"snapshot directory cannot be read: {error.strerror}")
        for child in children:
            source_path = source_dir / child.name
            destination_path = destination_dir / child.name
            try:
                before = source_path.lstat()
            except OSError as error:
                fail(f"snapshot entry changed during copy: {error.strerror}")
            if stat.S_ISLNK(before.st_mode):
                fail("snapshot contains a symlink")
            if stat.S_ISDIR(before.st_mode):
                destination_path.mkdir(mode=0o700)
                stack.append((source_path, destination_path, depth + 1))
                continue
            if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
                fail("snapshot contains a non-regular or hardlinked file")
            flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
            try:
                descriptor = os.open(source_path, flags)
            except OSError as error:
                fail(f"snapshot file cannot be opened safely: {error.strerror}")
            try:
                opened = os.fstat(descriptor)
                if (
                    not stat.S_ISREG(opened.st_mode)
                    or opened.st_nlink != 1
                    or (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino)
                ):
                    fail("snapshot file identity changed during copy")
                output_flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
                output_fd = os.open(destination_path, output_flags, 0o600)
                try:
                    with os.fdopen(descriptor, "rb", closefd=False) as input_file:
                        with os.fdopen(output_fd, "wb", closefd=False) as output_file:
                            shutil.copyfileobj(input_file, output_file, length=128 * 1024)
                            output_file.flush()
                            os.fsync(output_fd)
                    after = os.fstat(descriptor)
                    path_after = source_path.lstat()
                    if (
                        (opened.st_dev, opened.st_ino, opened.st_size, opened.st_mtime_ns)
                        != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
                        or (after.st_dev, after.st_ino) != (path_after.st_dev, path_after.st_ino)
                    ):
                        fail("snapshot file changed during copy")
                finally:
                    os.close(output_fd)
                mode = 0o555 if before.st_mode & 0o111 else 0o444
                os.chmod(destination_path, mode, follow_symlinks=False)
            finally:
                os.close(descriptor)
        try:
            directory_after = source_dir.lstat()
        except OSError as error:
            fail(f"snapshot directory changed during copy: {error.strerror}")
        if (directory_before.st_dev, directory_before.st_ino, directory_before.st_mtime_ns) != (
            directory_after.st_dev,
            directory_after.st_ino,
            directory_after.st_mtime_ns,
        ):
            fail("snapshot directory changed during copy")


def probe_adapter(adapter: str, executable: str) -> None:
    if adapter not in ADAPTERS:
        fail("adapter is not registered")
    path = Path(executable)
    try:
        info = path.lstat()
    except OSError:
        fail("approved adapter executable is missing", 1)
    if not stat.S_ISREG(info.st_mode) or not (info.st_mode & 0o111):
        fail("approved adapter executable is not an executable regular file", 1)
    if adapter == "pytest":
        command = [executable, "-c", "import pytest"]
    elif adapter in {"node-test", "node-lint", "node-typecheck"}:
        command = [executable, "--version"]
    else:
        command = [executable, "--version"]
    result = subprocess.run(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=clean_environment("/nonexistent", "/tmp"),
        check=False,
        timeout=5,
    )
    if result.returncode != 0:
        fail("approved adapter dependencies are not ready", 1)


def main(argv: list[str]) -> None:
    if len(argv) == 4 and argv[1] == "--probe-adapter":
        probe_adapter(argv[2], argv[3])
        return
    options, command = parse_invocation(argv[1:])
    source = Path(options.source)
    workspace_root = Path("/workspace")
    workspace = Path(options.workspace)
    if not workspace.is_absolute() or workspace != workspace_root and workspace_root not in workspace.parents:
        fail("working directory is outside the bounded workspace")
    try:
        source_resolved = source.resolve(strict=True)
        source_info = source.lstat()
        if not stat.S_ISDIR(source_info.st_mode):
            fail("snapshot source is not a real directory")
        if source_resolved != source:
            fail("snapshot source path is not canonical")
    except OSError as error:
        fail(f"snapshot source is unavailable: {error.strerror}")
    root_info = workspace_root.lstat()
    if not stat.S_ISDIR(root_info.st_mode):
        fail("bounded workspace mount is not a real directory")
    copy_snapshot(source, workspace)
    os.chdir(workspace)
    os.execve(command[0], command, clean_environment(options.home, options.tmp))


if __name__ == "__main__":
    main(sys.argv)
